{
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/user/{catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "financial-route": {
        "ClusterId": "financial-cluster",
        "Match": {
          "Path": "/api/financial/{catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://user-service:8080/"
          }
        }
      },
      "financial-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://financial-service:8080/"
          }
        }
      }
    }
  },

  "JwtTokenOptions":
  {
    "Secret": "VERY_LARGE_SECRET_HE_MUST_BE_HUGE",
    "Issuer" : "UserService",
    "Audience" : "ApiGateway",
    "AccessTokenLifetimeMinutes":"15",
    "RefreshTokenLifetimeDays":"7"
  }
}
